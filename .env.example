# 复制为 .env 后填值。.env 被 git 忽略，不要把真实凭证写进本文件。
# 缺哪个必填变量，对应入口启动时报 CONFIG_INVALID（或 STORAGE_ERROR）并列出名字。

# --- SQL Server（必填）：主机写 "主机" 或 "主机,端口"，默认端口 1433
DB_SERVER=
EVA_DB_USER=
EVA_DB_PASS=
EVA_DB_NAME=

# --- 旧库只读账号（可选）：只有 eva/storage/legacy_import.py 从旧库导入数据时用
LEGACY_DB_USER=
LEGACY_DB_PASS=

# --- MinIO（必填）：endpoint 写 "主机:端口"，是否 https 看 configs/storage.yaml 的 secure
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Redis：只有企微服务和模拟器需要，终端和评测不需要。PORT、DB 必须是整数，密码可空
EVA_REDIS_HOST=
EVA_REDIS_PORT=
EVA_REDIS_DB=
EVA_REDIS_PASSWORD=

# --- 模型（configs/model.yaml 里按名字引用）
QWEN_API_KEY=
QWEN_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# --- 录音转写（configs/asr.yaml 引用）
ASR_API_KEY=
ASR_BASE_URL=

# --- 联网搜索（智谱）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=

# --- 企业数据（企查查）
QCC_API_KEY=

# --- 企微：只有真实企微服务需要
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# --- EVA测评系统（devtools.web）的登录密码；评测会真调模型，请设强密码
EVA_DEVTOOLS_PASSWORD=
